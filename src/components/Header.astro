---
import { Menu, X } from "@lucide/astro";
import { getLocalizedPath, useTranslations, type Locale } from "~/i18n";
import LanguageSwitcher from "~/components/LanguageSwitcher.astro";

interface Props {
  lang: Locale;
  currentSlug?: string;
  alternateSlug?: string;
  variant?: "on-dark" | "on-light";
}

const { lang, currentSlug, alternateSlug, variant = "on-light" } = Astro.props;
const { t } = useTranslations(lang);

const homeHref = getLocalizedPath("", lang);

type NavItem = { labelKey: string; slug: string };

const navItems: NavItem[] = [
  { labelKey: "navigation.home", slug: "" },
  { labelKey: "navigation.about", slug: lang === "de" ? "ueber-uns" : "about" },
  {
    labelKey: "navigation.contact",
    slug: lang === "de" ? "kontakt" : "contact",
  },
];

function isActive(slug: string): boolean {
  return currentSlug === slug || (slug === "" && currentSlug === undefined);
}

const isOnDark = variant === "on-dark";
// The on-dark header is transparent over the hero but must turn solid when
// scrolled or when the mobile menu is open (script toggles `data-solid`).
const headerBg = isOnDark
  ? "bg-transparent data-solid:bg-surface-dark/80"
  : "bg-surface/80";
const headerBorder = isOnDark
  ? "border-transparent data-solid:border-white/5"
  : "border-border/50";
const logoTextColor = isOnDark ? "text-text-on-dark" : "text-text-heading";
const navLinkBase =
  "text-sm font-medium transition-colors duration-[var(--transition-fast)]";
const navLinkInactive = isOnDark
  ? "text-text-on-dark/60 hover:text-text-on-dark"
  : "text-muted hover:text-text-heading";
const navLinkActive = isOnDark
  ? "text-text-on-dark font-semibold"
  : "text-accent font-semibold";
const hamburgerColor = isOnDark ? "text-text-on-dark" : "text-text-heading";
---

<header
  id="site-header"
  class={`pf-vt-header sticky top-0 z-50 ${headerBg} backdrop-blur-xl backdrop-saturate-150 border-b ${headerBorder}`}
>
  <div class="container">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href={homeHref}
        class={`inline-flex items-center gap-2 text-lg font-bold tracking-tight ${logoTextColor} hover:opacity-80 transition-opacity`}
        aria-label={`${t("site.name")} – Home`}
      >
        <svg
          viewBox="0 0 32 32"
          aria-hidden="true"
          class="h-7 w-7 shrink-0"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            x="2"
            y="2"
            width="28"
            height="28"
            rx="8"
            fill="currentColor"
            opacity="0.12"></rect>
          <path d="M7 22L14.5 10L18.5 17L22.5 13L25 22H7Z" fill="currentColor"
          ></path>
          <path d="M14.5 10L11 17H18L14.5 10Z" fill="currentColor" opacity="0.8"
          ></path>
          <path
            d="M8 24H24"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <span>{t("site.name")}</span>
      </a>

      <!-- Desktop nav -->
      <nav
        class="hidden md:flex items-center gap-6"
        aria-label="Main navigation"
      >
        {
          navItems.map((item) => (
            <a
              href={getLocalizedPath(item.slug, lang)}
              class={`${navLinkBase} ${isActive(item.slug) ? navLinkActive : navLinkInactive}`}
              aria-current={isActive(item.slug) ? "page" : undefined}
            >
              {t(item.labelKey)}
            </a>
          ))
        }
      </nav>

      <!-- Right: language switcher + mobile hamburger -->
      <div class="flex items-center gap-4">
        <LanguageSwitcher
          lang={lang}
          currentSlug={currentSlug}
          alternateSlug={alternateSlug}
        />

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class={`md:hidden flex items-center justify-center w-10 h-10 rounded-md ${hamburgerColor} focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2`}
        >
          <Menu size={20} aria-hidden="true" id="hamburger-icon" />
          <X size={20} aria-hidden="true" id="close-icon" class="hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-border/50"
    aria-label="Mobile navigation"
  >
    <div class="container py-4 flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={getLocalizedPath(item.slug, lang)}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors duration-[var(--transition-fast)] ${
              isActive(item.slug)
                ? "bg-accent/10 text-accent"
                : isOnDark
                  ? "text-text-on-dark/80 hover:bg-white/10 hover:text-text-on-dark"
                  : "text-text hover:bg-surface-dark/5 hover:text-text-heading"
            }`}
            aria-current={isActive(item.slug) ? "page" : undefined}
          >
            {t(item.labelKey)}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (!header || !toggle || !menu) return;

    let isOpen = false;

    // The open mobile menu grows the sticky header beyond the hero's -mt-16
    // pull-up, so the page's light body would show through a transparent
    // header — it must go solid while open, not only after scrolling.
    function syncBackground() {
      header!.toggleAttribute("data-solid", isOpen || window.scrollY > 80);
    }

    function open() {
      isOpen = true;
      menu!.classList.remove("hidden");
      toggle!.setAttribute("aria-expanded", "true");
      toggle!.setAttribute("aria-label", "Close menu");
      hamburgerIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      syncBackground();
    }

    function close() {
      isOpen = false;
      menu!.classList.add("hidden");
      toggle!.setAttribute("aria-expanded", "false");
      toggle!.setAttribute("aria-label", "Open menu");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      syncBackground();
    }

    toggle.addEventListener("click", () => {
      isOpen ? close() : open();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        close();
        toggle.focus();
      }
    });

    // Close on nav link click
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });

    window.addEventListener("scroll", syncBackground, { passive: true });
    syncBackground();
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
